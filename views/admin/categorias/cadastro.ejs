
<%- include('../partials/header') %>

<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <i class="bi bi-tags"></i>
                <%= categoria ? 'Editar categoria' : 'Cadastro de categoria' %>
            </h4>
        </div>

        <div class="card-body">
            <form
                action="<%= categoria ? '/admin/categorias/editar/' + categoria.id : '/admin/categorias/cadastrar' %>"
                method="POST"
            >

                <div class="mb-3">
                    <label for="nome" class="form-label">
                        Nome da categoria
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="nome"
                        name="nome"
                        maxlength="100"
                        value="<%= categoria ? categoria.nome : '' %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="regiao" class="form-label">
                        Região vinícola
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="regiao"
                        name="regiao"
                        maxlength="150"
                        placeholder="Ex.: Vale dos Vinhedos, Serra Gaúcha"
                        value="<%= categoria ? (categoria.regiao || '') : '' %>"
                    >

                    <div class="form-text">
                        Região de origem associada a esta categoria.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea
                        class="form-control"
                        id="descricao"
                        name="descricao"
                        rows="3"
                        maxlength="500"
                    ><%= categoria ? (categoria.descricao || '') : '' %></textarea>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i>
                    <%= categoria ? 'Salvar alterações' : 'Cadastrar' %>
                </button>

                <a href="/admin/categorias" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
