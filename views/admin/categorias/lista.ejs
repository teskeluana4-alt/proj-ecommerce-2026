
<%- include('../partials/header') %>

<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-tags"></i> Categorias de vinhos
                </h4>

                <a href="/admin/categorias/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Nova categoria
                </a>
            </div>
        </div>

        <div class="card-body">

            <% if (!categorias.length) { %>

                <div class="text-center py-5">
                    <h5>Nenhuma categoria cadastrada</h5>
                    <p class="text-secondary">
                        Crie categorias como Tintos, Brancos, Rosés e Espumantes.
                    </p>

                    <a href="/admin/categorias/form-cadastrar" class="btn btn-success">
                        Cadastrar categoria
                    </a>
                </div>

            <% } else { %>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Região vinícola</th>
                                <th>Descrição</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% categorias.forEach(categoria => { %>
                                <tr>
                                    <td><%= categoria.id %></td>
                                    <td><%= categoria.nome %></td>
                                    <td><%= categoria.regiao || '—' %></td>
                                    <td><%= categoria.descricao || '—' %></td>

                                    <td class="text-nowrap">
                                        <a
                                            href="/admin/categorias/editar/<%= categoria.id %>"
                                            class="btn btn-warning btn-sm"
                                        >
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>

                                        <form
                                            action="/admin/categorias/excluir/<%= categoria.id %>"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('Excluir esta categoria?')"
                                        >
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i> Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>
    </div>
</main>

<%- include('../partials/footer') %>
