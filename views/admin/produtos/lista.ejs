
<%- include('../partials/header') %>

<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center gap-2">

                <h4 class="mb-0">
                    <i class="bi bi-wine"></i>
                    Vinhos cadastrados
                </h4>

                <a
                    href="/admin/produtos/form-cadastrar"
                    class="btn btn-light btn-sm"
                >
                    <i class="bi bi-plus-circle"></i>
                    Novo vinho
                </a>

            </div>

        </div>

        <div class="card-body">

            <% if (!produtos.length) { %>

                <div class="text-center py-5">

                    <i class="bi bi-wine display-4 text-secondary"></i>

                    <h5 class="mt-3">
                        Ainda não há vinhos cadastrados
                    </h5>

                    <p class="text-secondary">
                        Cadastre o primeiro produto da vinícola.
                    </p>

                    <a
                        href="/admin/produtos/form-cadastrar"
                        class="btn btn-primary"
                    >
                        Cadastrar vinho
                    </a>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>Vinho</th>
                                <th>Categoria</th>
                                <th>Uva</th>
                                <th>Ano</th>
                                <th>Preço</th>
                                <th>Estoque</th>
                                <th>Imagem</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% produtos.forEach(produto => { %>

                                <tr>

                                    <td>
                                        <%= produto.id %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= produto.nome %>
                                        </strong>

                                        <% if (produto.descricao) { %>

                                            <div class="small text-secondary">
                                                <%= produto.descricao %>
                                            </div>

                                        <% } %>
                                    </td>

                                    <td>
                                        <%= produto.categoria || 'Sem categoria' %>
                                    </td>

                                    <td>
                                        <%= produto.uva || '—' %>
                                    </td>

                                    <td>
                                        <%= produto.ano || '—' %>
                                    </td>

                                    <td>
                                        <%= Number(produto.valor || 0).toLocaleString(
                                            'pt-BR',
                                            {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }
                                        ) %>
                                    </td>

                                    <td>

                                        <span class="badge <%= produto.estoque > 0 ? 'text-bg-success' : 'text-bg-danger' %>">
                                            <%= produto.estoque %>
                                        </span>

                                    </td>

                                    <td>

                                        <% if (produto.imagem) { %>

                                            <img
                                                src="/uploads/<%= encodeURIComponent(produto.imagem) %>"
                                                alt="<%= produto.nome %>"
                                                style="width: 55px; height: 70px; object-fit: contain;"
                                                class="border rounded bg-white p-1"
                                            >

                                        <% } else { %>

                                            <span class="text-secondary small">
                                                Sem imagem
                                            </span>

                                        <% } %>

                                    </td>

                                    <td class="text-nowrap">

                                        <a
                                            href="/admin/produtos/editar/<%= produto.id %>"
                                            class="btn btn-warning btn-sm"
                                        >
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>

                                        <form
                                            action="/admin/produtos/excluir/<%= produto.id %>"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('Tem certeza que deseja excluir este vinho?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-danger btn-sm"
                                            >
                                                <i class="bi bi-trash"></i>
                                                Excluir
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>
